NODE_ENV=development
PORT=4000

# Neon Postgres connection string (with SSL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# JWT secrets — use long random strings
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Frontend app URL used for reset-password links
FRONTEND_URL="http://localhost:5173"

# Password reset token expiration
RESET_PASSWORD_TTL_MINUTES=30

# SMTP mailer settings (required for forgot-password emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="no-reply@afterhours.local"

# Comma-separated origins allowed for browser requests with credentials
# Example production: "https://app.example.com,https://admin.example.com"
CORS_ORIGINS="http://localhost:5173"

# If behind a reverse proxy / load balancer (Render, Railway, Fly, Nginx, etc.)
TRUST_PROXY=false

# Cookie behavior for auth tokens
# Use none for cross-site frontend/backend domains (requires HTTPS + secure cookies)
AUTH_COOKIE_SAME_SITE="lax"

# Optional cookie domain, e.g. ".example.com" for shared subdomains
AUTH_COOKIE_DOMAIN=

# Structured backend log verbosity: debug | info | warn | error
LOG_LEVEL="info"

# Optional webhook endpoint for unhandled error tracking
ERROR_WEBHOOK_URL=

# Media upload provider
# local: stores files in backend/uploads and serves via /media
# cloudinary: uploads directly to Cloudinary and stores secure URL in DB
MEDIA_PROVIDER="local"
MEDIA_PUBLIC_BASE_URL="http://localhost:4000"
MEDIA_CLOUDINARY_FOLDER="after-hours-grind"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Strava OAuth integration
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI="http://localhost:8080/student/feed"
STRAVA_SYNC_PER_PAGE=20

# Optional fallback WhatsApp number used when trainer profile has no value
DEFAULT_TRAINER_WHATSAPP_NUMBER=

# Seed security (required for prisma db seed)
SEED_ADMIN_EMAIL="admin@ahg.com"
SEED_ADMIN_PASSWORD="ChangeThisToAStrongAdminPassword!123"
