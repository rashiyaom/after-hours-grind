NODE_ENV=development
PORT=4000

# Neon Postgres connection string (with SSL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# JWT secrets — use long random strings
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Comma-separated origins allowed for browser requests with credentials
# Example production: "https://app.example.com,https://admin.example.com"
CORS_ORIGINS="http://localhost:5173"

# If behind a reverse proxy / load balancer (Render, Railway, Fly, Nginx, etc.)
TRUST_PROXY=false

# Cookie behavior for auth tokens
# Use none for cross-site frontend/backend domains (requires HTTPS + secure cookies)
AUTH_COOKIE_SAME_SITE="lax"

# Optional cookie domain, e.g. ".example.com" for shared subdomains
AUTH_COOKIE_DOMAIN=
