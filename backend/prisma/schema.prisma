generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TRAINER
  ADMIN
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlanStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
}

model RolePermission {
  id         String @id @default(cuid())
  role       Role
  permission String
  allowed    Boolean @default(false)

  @@unique([role, permission])
  @@index([role])
}

// ─── USERS ───────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatar       String   @default("")
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isBanned     Boolean  @default(false)

  studentProfile StudentProfile?
  trainerProfile TrainerProfile?
  settings       UserSettings?

  posts        Post[]
  comments     Comment[]
  likes        Like[]
  submissions  Submission[]     @relation("SubmittedBy")
  reviewed     Submission[]     @relation("ReviewedBy")
  notifications Notification[]

  followers    Follow[]  @relation("Following")
  following    Follow[]  @relation("Follower")

  sentMessages ChatMessage[]
  threadParticipants ThreadParticipant[]

  refreshTokens RefreshToken[]
  achievements  UserAchievement[]
  progress      ProgressEntry[]

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model StudentProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId           String   @default("")
  heightCm            Float    @default(170)
  weightKg            Float    @default(70)
  fitnessGoal         String   @default("")
  streak              Int      @default(0)
  totalPlansCompleted Int      @default(0)
  totalPoints         Int      @default(0)
  trainerId           String?
  currentPlanId       String?
  onboardingCompleted Boolean  @default(false)
  onboardingStep      Int      @default(1)
  onboardingDraft     Json?
  sport               String?
  team                String?

  @@index([trainerId])
}

model TrainerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String   @default("")
  whatsappNumber String?
  experience     Int      @default(0)
  certifications String[] @default([])
  isVerified     Boolean  @default(false)
}

// ─── USER SETTINGS ───────────────────────────────────────

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  profileVisibility  String   @default("public")
  showStreak         Boolean  @default(true)
  showLeaderboard    Boolean  @default(true)
  theme              String   @default("dark")
  updatedAt          DateTime @updatedAt
}

// ─── SOCIAL ──────────────────────────────────────────────

model Follow {
  id          String @id @default(cuid())
  followerId  String
  followingId String
  follower    User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("image")
  mediaUrl  String   @default("")
  caption   String   @default("")
  source    String   @default("general")
  location  String   @default("")
  status    String   @default("visible")
  createdAt DateTime @default(now())

  comments Comment[]
  likes    Like[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([postId])
}

model Like {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

// ─── PLANS ───────────────────────────────────────────────

model Plan {
  id          String     @id @default(cuid())
  name        String
  trainerId   String?
  studentId   String?
  difficulty  String     @default("beginner")
  goalType    String     @default("")
  status      PlanStatus @default(DRAFT)
  reviewNote  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  days PlanDay[]

  @@index([studentId])
  @@index([trainerId])
}

model PlanDay {
  id     String @id @default(cuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  day    Int

  tasks PlanTask[]

  @@unique([planId, day])
}

model PlanTask {
  id          String @id @default(cuid())
  planDayId   String
  planDay     PlanDay @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String  @default("")
  durationMin Int     @default(0)
  intensity   String  @default("moderate")
  points      Int     @default(10)

  submissions Submission[]
}

// ─── SUBMISSIONS ─────────────────────────────────────────

model Submission {
  id           String           @id @default(cuid())
  studentId    String
  student      User             @relation("SubmittedBy", fields: [studentId], references: [id], onDelete: Cascade)
  planTaskId   String?
  planTask     PlanTask?        @relation(fields: [planTaskId], references: [id], onDelete: SetNull)
  mediaUrl     String           @default("")
  status       SubmissionStatus @default(PENDING)
  trainerNote  String?
  reviewedById String?
  reviewedBy   User?            @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  reviewedAt   DateTime?

  @@index([studentId])
  @@index([status])
}

// ─── NOTIFICATIONS ───────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ─── CHAT ────────────────────────────────────────────────

model ChatThread {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  participants ThreadParticipant[]
  messages     ChatMessage[]
}

model ThreadParticipant {
  id       String     @id @default(cuid())
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastRead DateTime   @default(now())

  @@unique([threadId, userId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text      String
  type      String     @default("text")
  voiceSeconds Int?
  voiceAudioUrl String?
  reelPostId String?
  reelPreviewUrl String?
  reelCaption String?
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

// ─── EVENTS ──────────────────────────────────────────────

model Event {
  id               String       @id @default(cuid())
  title            String
  description      String
  date             DateTime
  location         String
  category         String       @default("General")
  status           String       @default("upcoming")
  mediaType        String       @default("image")
  mediaUrl         String       @default("")
  registrationOpen Boolean      @default(true)
  formFields       Json         @default("[]")
  createdAt        DateTime     @default(now())
  createdBy        String

  entries          EventEntry[]
}

model EventEntry {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String?
  submittedAt DateTime @default(now())
  responses   Json     @default("{}")

  @@index([eventId])
}

// ─── ACHIEVEMENTS ────────────────────────────────────────

model AchievementDef {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String @default("")
  icon        String @default("🏆")
  category    String @default("general")
  threshold   Int    @default(1)
  points      Int    @default(0)
  createdAt   DateTime @default(now())

  earned UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   AchievementDef @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

// ─── PROGRESS TRACKING ──────────────────────────────────

model ProgressEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @default(now()) @db.Date
  weightKg        Float?
  bodyFatPct      Float?
  stepCount       Int?
  workoutMinutes  Int?
  caloriesBurned  Int?
  sleepHours      Float?
  waterLiters     Float?
  mood            String?
  notes           String?
  createdAt       DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}
